import React, { useRef, useState } from 'react';
import { ActivityIndicator, Alert, Image, Pressable, StatusBar, StyleSheet, Text, TextInput, View, type TextProps } from 'react-native';
import MapView, { Marker, UrlTile, type Region } from 'react-native-maps';
import * as Location from 'expo-location';
import { Ionicons, MaterialCommunityIcons } from '@expo/vector-icons';
import { useFonts, Baloo2_700Bold } from '@expo-google-fonts/baloo-2';
import { Nunito_400Regular, Nunito_600SemiBold, Nunito_700Bold } from '@expo-google-fonts/nunito';
import { SafeAreaProvider, SafeAreaView } from 'react-native-safe-area-context';

const naranja = '#FF8A00';
const claro = '#FFC28A';
const durazno = '#FFE7D2';
const marron = '#5A3A1F';
const blanco = '#FFFFFF';
const gris = '#F2F2F2';
const filtros = ['Todos los Puntos', 'Perdidos', 'Encontrados'];
const navegacion = [
  ['Inicio', 'paw'],
  ['Mapa', 'map'],
  ['Tienda', 'cart'],
  ['Perfil', 'account'],
] as const;

const mascotas = [
  {
    id: 'milo',
    nombre: 'Milo',
    estado: 1,
    descripcion: 'Caniche Toy · Macho',
    ubicacion: 'Barrio Champagnat, Pilar',
    tiempo: 'Perdido hace 2 horas',
    recompensa: '$15.000',
    foto: require('./assets/milo.png') as number,
    coordenadas: { latitude: -34.4497, longitude: -58.9194 },
  },
  {
    id: 'luna',
    nombre: 'Luna',
    estado: 2,
    descripcion: 'Mestiza · Hembra',
    ubicacion: 'Plaza 12 de Octubre, Pilar',
    tiempo: 'Encontrada hace 1 hora',
    recompensa: null,
    foto: { uri: 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=600&auto=format&fit=crop&q=80' },
    coordenadas: { latitude: -34.4587, longitude: -58.9142 },
  },
];

function Texto({ size = 11, font = 'Nunito_700Bold', style, ...props }:
  TextProps & { size?: number; font?: string }) {
  return <Text {...props} style={[{
    color: marron,
    fontSize: size,
    fontFamily: font,
  }, style]} />;
}

function Punto({ color = naranja }: { color?: string }) {
  return <View style={[styles.punto, { backgroundColor: color }]} />;
}

export default function App() {
  const [cargadas, error] = useFonts({ Baloo2_700Bold, Nunito_400Regular, Nunito_600SemiBold, Nunito_700Bold });
  if (!cargadas && !error) return null;
  return <SafeAreaProvider><Mapa /></SafeAreaProvider>;
}

function Mapa() {
  const mapa = useRef<MapView>(null);
  const region = useRef<Region>({
    latitude: -34.458,
    longitude: -58.914,
    latitudeDelta: 0.035,
    longitudeDelta: 0.035,
  });
  const [filtro, setFiltro] = useState(1);
  const [mascota, setMascota] = useState<(typeof mascotas)[number] | null>(mascotas[0]);
  const [localizando, setLocalizando] = useState(false);
  const [altoTarjeta, setAltoTarjeta] = useState(230);
  const [usuario, setUsuario] = useState<{ latitude: number; longitude: number } | null>(null);
  const visibles = mascotas.filter(p => filtro === 0 || p.estado === filtro);

  function cambiarFiltro(valor: number) {
    setFiltro(valor);
    setMascota(actual => actual && (valor === 0 || actual.estado === valor) ? actual : null);
  }

  async function localizar() {
    if (localizando) return;
    setLocalizando(true);
    try {
      const permiso = await Location.requestForegroundPermissionsAsync();
      if (!permiso.granted) {
        Alert.alert('Ubicación', 'Permití el acceso a tu ubicación para centrar el mapa.');
        return;
      }
      const { coords } = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced });
      const posicion = { latitude: coords.latitude, longitude: coords.longitude };
      setUsuario(posicion);
      mapa.current?.animateToRegion({ ...posicion, latitudeDelta: 0.008, longitudeDelta: 0.008 }, 350);
    } catch {
      Alert.alert('Ubicación', 'No se pudo obtener tu ubicación. Revisá los permisos.');
    } finally {
      setLocalizando(false);
    }
  }

  function acercar() {
    mapa.current?.animateToRegion({
      ...region.current,
      latitudeDelta: Math.max(region.current.latitudeDelta / 2, 0.0005),
      longitudeDelta: Math.max(region.current.longitudeDelta / 2, 0.0005),
    }, 250);
  }

  return (
    <SafeAreaView style={styles.pantalla}>
      <StatusBar barStyle="dark-content" />
      <View style={styles.header}>
        <View style={styles.fila}>
          <View style={styles.titulos}>
            <Texto size={23} font="Baloo2_700Bold" style={styles.titulo} numberOfLines={1} adjustsFontSizeToFit>Mapa Comunitario 🗺️</Texto>
            <Texto size={12} font="Nunito_400Regular">Radar de alertas y campañas en Pilar</Texto>
          </View>
          <View style={[styles.fila, styles.vivo]}><Punto /><Texto>En Vivo</Texto></View>
        </View>
        <View style={[styles.fila, styles.buscador]}>
          <Ionicons name="search-outline" size={22} color={marron} />
          <TextInput style={styles.input} placeholder="Buscar por barrio, calle o campaña..." placeholderTextColor={marron} />
          <Ionicons name="options-outline" size={22} color={marron} />
        </View>
        <View style={[styles.fila, styles.filtros]}>
          {filtros.map((nombre, i) => (
            <Pressable key={nombre} onPress={() => cambiarFiltro(i)} accessibilityRole="button"
              accessibilityState={{ selected: filtro === i }}
              style={[styles.fila, styles.filtro, { flex: i === 0 ? 1.25 : 1 }, filtro === i && styles.naranja]}>
              {i > 0 && <Punto color={filtro === i ? blanco : i === 1 ? naranja : claro} />}
              <Texto font={filtro === i ? 'Nunito_700Bold' : 'Nunito_600SemiBold'}
                style={[styles.encoger, { color: filtro === i ? blanco : marron }]} numberOfLines={1} adjustsFontSizeToFit>{nombre}</Texto>
            </Pressable>
          ))}
        </View>
      </View>


      <View style={styles.mapa}>
        <MapView ref={mapa} style={StyleSheet.absoluteFill} initialRegion={region.current}
          onRegionChangeComplete={valor => { region.current = valor; }}
          mapPadding={{ top: 0, left: 0, right: 0, bottom: mascota ? altoTarjeta + 24 : 0 }}
          mapType="none" showsCompass={false} showsMyLocationButton={false} toolbarEnabled={false} moveOnMarkerPress={false}>
          <UrlTile urlTemplate="https://tile.openstreetmap.org/{z}/{x}/{y}.png" maximumZ={19} />
          {visibles.map(p => (
            <Marker key={p.id} coordinate={p.coordenadas} anchor={{ x: 0.5, y: 0.85 }} onPress={() => setMascota(p)}>
              <View style={styles.pin}>
                <View style={[styles.centro, styles.pinCirculo, { backgroundColor: p.estado === 1 ? naranja : claro }]}>
                  <Ionicons name={p.estado === 1 ? 'paw' : 'checkmark'} size={25} color={blanco} />
                </View>
                <View style={styles.pinNombre}><Texto size={10}>{p.nombre}</Texto></View>
              </View>
            </Marker>
          ))}
          {usuario && <Marker coordinate={usuario}><View style={styles.usuario} /></Marker>}
        </MapView>
        <View style={[styles.fila, styles.leyenda]} pointerEvents="none">
          {['Perdidos', 'Encontrados', 'Campañas'].map((nombre, i) => (
            <View key={nombre} style={[styles.fila, styles.leyendaItem]}>
              <Punto color={[naranja, claro, marron][i]} />
              <Texto size={9} font="Nunito_600SemiBold">{nombre}</Texto>
            </View>
          ))}
        </View>
        <View style={styles.controles}>
          <Pressable onPress={localizar} disabled={localizando} accessibilityLabel="Ir a mi ubicación" style={[styles.centro, styles.control, styles.naranja]}>
            {localizando ? <ActivityIndicator color={blanco} /> : <MaterialCommunityIcons name="crosshairs-gps" size={25} color={blanco} />}
          </Pressable>
          <Pressable onPress={acercar} accessibilityLabel="Acercar mapa" style={[styles.centro, styles.control]}>
            <Ionicons name="add" size={31} color={naranja} />
          </Pressable>
        </View>

        {mascota && (
          <View style={styles.tarjeta} onLayout={e => setAltoTarjeta(e.nativeEvent.layout.height)}>
            <Pressable onPress={() => setMascota(null)} accessibilityLabel="Cerrar tarjeta" style={styles.cerrar} hitSlop={6}>
              <Ionicons name="close" size={22} color={marron} />
            </Pressable>
            <View style={styles.tarjetaArriba}>
              <Image source={mascota.foto} style={styles.foto} />
              <View style={styles.datos}>
                <View style={[styles.fila, styles.etiquetas]}>
                  <Texto size={8.5} style={styles.etiqueta}>{mascota.estado === 1 ? 'Alerta de Búsqueda' : 'Mascota Encontrada'}</Texto>
                  {mascota.recompensa && <Texto size={8.5} style={[styles.etiqueta, styles.claro]}>Recompensa: {mascota.recompensa}</Texto>}
                </View>
                <Texto size={21} font="Baloo2_700Bold" style={styles.nombre}>{mascota.nombre}</Texto>
                <Texto font="Nunito_400Regular">{mascota.descripcion}</Texto>
              </View>
            </View>
            <View style={[styles.fila, styles.info]}>
              <Ionicons name="location" size={19} color={naranja} />
              <Texto size={10.5} font="Nunito_600SemiBold" style={styles.encoger}>{mascota.ubicacion}</Texto>
            </View>
            <View style={[styles.fila, styles.info]}>
              <Ionicons name="time-outline" size={19} color={marron} />
              <View style={styles.tiempo}><Punto /></View>
              <Texto size={10.5} font="Nunito_600SemiBold" style={styles.encoger}>{mascota.tiempo}</Texto>
            </View>
            <View style={[styles.fila, styles.botones]}>
              <Pressable style={[styles.fila, styles.boton, styles.naranja]}>
                <Texto size={10.5} style={styles.blanco}>Ver Ficha Completa</Texto>
                <Ionicons name="arrow-forward" size={18} color={blanco} />
              </Pressable>
              <Pressable style={[styles.fila, styles.boton]}>
                <Ionicons name="eye-outline" size={18} color={marron} />
                <Texto size={10.5}>Avisar que lo vi</Texto>
              </Pressable>
            </View>
          </View>
        )}
        <Texto size={8} font="Nunito_400Regular" style={styles.atribucion}>© OpenStreetMap contributors</Texto>
      </View>
      <View style={[styles.fila, styles.nav]}>
        {navegacion.map(([nombre, icono]) => (
          <View key={nombre} style={[styles.centro, styles.navItem]}>
            <MaterialCommunityIcons name={icono} size={27} color={nombre === 'Mapa' ? naranja : marron} />
            <Texto size={10} style={{ color: nombre === 'Mapa' ? naranja : marron }}>{nombre}</Texto>
          </View>
        ))}
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  pantalla: {
    flex: 1,
    backgroundColor: blanco,
  },
  fila: {
    flexDirection: 'row',
    alignItems: 'center',
  },
  centro: {
    alignItems: 'center',
    justifyContent: 'center',
  },
  mapa: {
    flex: 1,
  },
  header: {
    paddingHorizontal: 16,
    paddingTop: 8,
    paddingBottom: 9,
  },
  titulos: {
    flex: 1,
    marginRight: 8,
  },
  titulo: {
    lineHeight: 27,
  },
  vivo: {
    paddingHorizontal: 10,
    paddingVertical: 6,
    borderRadius: 18,
    backgroundColor: durazno,
    gap: 5,
  },
  buscador: {
    height: 46,
    marginTop: 10,
    paddingHorizontal: 14,
    borderWidth: 1,
    borderColor: gris,
    borderRadius: 15,
  },
  input: {
    flex: 1,
    marginLeft: 8,
    fontFamily: 'Nunito_400Regular',
    fontSize: 13,
    color: marron,
  },
  filtros: {
    marginTop: 10,
    height: 36,
    alignItems: 'flex-start',
    gap: 7,
  },
  filtro: {
    justifyContent: 'center',
    height: 34,
    paddingHorizontal: 6,
    borderRadius: 18,
    backgroundColor: claro,
    gap: 4,
  },
  punto: {
    width: 8,
    height: 8,
    borderRadius: 8,
  },
  encoger: {
    flexShrink: 1,
  },
  naranja: {
    backgroundColor: naranja,
  },
  claro: {
    backgroundColor: claro,
  },
  blanco: {
    color: blanco,
  },
  pin: {
    width: 58,
    height: 72,
    alignItems: 'center',
  },
  pinCirculo: {
    width: 40,
    height: 40,
    borderRadius: 20,
    borderWidth: 3,
    borderColor: blanco,
    elevation: 4,
    boxShadow: '0 2px 3px rgba(0,0,0,0.2)',
  },
  pinNombre: {
    marginTop: 2,
    paddingHorizontal: 8,
    paddingVertical: 3,
    borderRadius: 7,
    backgroundColor: blanco,
  },
  usuario: {
    width: 19,
    height: 19,
    borderRadius: 10,
    borderWidth: 3,
    borderColor: blanco,
    backgroundColor: '#2684FF',
  },
  leyenda: {
    position: 'absolute',
    top: 12,
    left: 12,
    paddingHorizontal: 10,
    paddingVertical: 8,
    borderRadius: 18,
    backgroundColor: blanco,
    elevation: 4,
    gap: 9,
  },
  leyendaItem: {
    gap: 4,
  },
  controles: {
    position: 'absolute',
    top: 13,
    right: 13,
  },
  control: {
    width: 46,
    height: 46,
    borderRadius: 23,
    marginBottom: 9,
    backgroundColor: blanco,
    elevation: 5,
  },
  tarjeta: {
    position: 'absolute',
    left: 12,
    right: 12,
    bottom: 12,
    padding: 13,
    borderRadius: 20,
    backgroundColor: blanco,
    elevation: 10,
    boxShadow: '0 4px 10px rgba(0,0,0,0.16)',
  },
  cerrar: {
    position: 'absolute',
    top: 6,
    right: 6,
    padding: 6,
    zIndex: 1,
  },
  tarjetaArriba: {
    flexDirection: 'row',
    paddingRight: 23,
  },
  foto: {
    width: 70,
    height: 70,
    borderRadius: 14,
    backgroundColor: durazno,
  },
  datos: {
    flex: 1,
    marginLeft: 10,
  },
  etiquetas: {
    flexWrap: 'wrap',
    gap: 4,
  },
  etiqueta: {
    paddingHorizontal: 6,
    paddingVertical: 3,
    borderRadius: 8,
    backgroundColor: durazno,
  },
  nombre: {
    marginTop: 3,
    lineHeight: 24,
  },
  info: {
    marginTop: 7,
    gap: 5,
  },
  tiempo: {
    marginLeft: 2,
  },
  botones: {
    marginTop: 11,
    gap: 7,
  },
  boton: {
    flex: 1,
    height: 43,
    paddingHorizontal: 7,
    borderRadius: 13,
    justifyContent: 'center',
    backgroundColor: gris,
    gap: 5,
  },
  atribucion: {
    position: 'absolute',
    bottom: 0,
    right: 0,
    paddingHorizontal: 4,
    backgroundColor: 'rgba(255,255,255,0.9)',
  },
  nav: {
    paddingTop: 8,
    paddingBottom: 2,
    borderTopWidth: 1,
    borderTopColor: gris,
  },
  navItem: {
    flex: 1,
    minHeight: 56,
    gap: 1,
  },
});
